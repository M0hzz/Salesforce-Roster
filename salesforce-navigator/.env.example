# SharePoint storage — copy to .env.local and fill in.
# All values are safe to expose to the browser (no secrets: the app uses
# delegated sign-in through MSAL, not an app secret).

# Entra ID app registration (single-page application) client id.
VITE_SP_CLIENT_ID=

# Directory (tenant) id, or leave blank to use the multi-tenant
# "organizations" endpoint.
VITE_SP_TENANT_ID=

# SharePoint hostname, e.g. contoso.sharepoint.com
VITE_SP_HOSTNAME=

# Server-relative site path, e.g. /sites/SalesOps
VITE_SP_SITE_PATH=

# Optional list name overrides (defaults come from lists.schema.json).
#VITE_SP_ROSTER_LIST=Roster
#VITE_SP_ACTIVITY_LIST=Activity
